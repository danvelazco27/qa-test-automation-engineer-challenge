{
  "name": "qa-test-automation-engineer-challenge",
  "version": "1.0.0",
  "description": "QA test automation framework for DemoQA Book Store — Playwright + TypeScript + Zod",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint . --ext .ts",
    "test:ui": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test": "playwright test",
    "test:coverage": "c8 --reporter=html --reporter=text --reports-dir=reports/coverage npx playwright test tests/e2e --project=chromium",
    "test:report": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.52.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "c8": "^10.1.3",
    "eslint": "^8.57.1",
    "eslint-plugin-playwright": "^2.10.2",
    "typescript": "^5.8.3",
    "zod": "^3.24.2"
  }
}
